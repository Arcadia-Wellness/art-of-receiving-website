---
import { getStrings, type Locale } from "@/i18n/strings";
import { artists, works } from "@/data/gallery";
import { assetUrl, localePath } from "@/lib/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = getStrings(locale);
---

<section class="px-5 pb-16 pt-10 md:px-8">
  <div class="mx-auto max-w-6xl">
    <header class="paper-panel mx-auto max-w-3xl px-6 py-8 text-center md:px-10">
      <h1 class="font-heiti text-4xl tracking-wide text-ink md:text-5xl">{s.gallery.title}</h1>
      <p class="mt-4 text-base leading-relaxed text-moss-800 md:text-lg">{s.gallery.lead}</p>
    </header>

    <h2 class="mt-14 font-heiti text-2xl tracking-wide text-ink md:text-3xl">{s.gallery.worksHeading}</h2>
    <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        works.map((work) => (
          <article class="paper-panel overflow-hidden">
            <div class="aspect-[4/5] overflow-hidden bg-mist">
              <img
                src={assetUrl(work.image)}
                alt={work.title[locale]}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="px-4 py-5">
              <h3 class="font-display text-xl text-ink">{work.title[locale]}</h3>
              {work.year && <p class="mt-1 text-sm text-moss-700">{work.year}</p>}
              <p class="mt-3 text-sm leading-relaxed text-moss-800">{work.blurb[locale]}</p>
              <p class="mt-3 text-xs tracking-wide text-moss-700">
                {work.artistIds
                  .map((id) => artists.find((a) => a.id === id)?.name[locale])
                  .filter(Boolean)
                  .join(" · ")}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-12 flex flex-wrap justify-center gap-6 text-center">
      <a href={localePath(locale, "artists")} class="text-sm text-moss-800 underline underline-offset-4">
        {s.nav.artists}
      </a>
      <a href={localePath(locale, "home")} class="text-sm text-moss-800 underline underline-offset-4">
        {locale === "zh" ? "返回首页" : "Back to home"}
      </a>
    </p>
  </div>
</section>
