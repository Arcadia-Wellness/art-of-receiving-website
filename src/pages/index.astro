---
/**
 * GitHub Pages entry. Serve the default-locale homepage here so the root URL
 * never hits a meta-refresh interstitial (Astro static redirects flash for ~2s,
 * and even a 0-delay hop can linger in browser/CDN cache).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeScroll from "@/components/HomeScroll.astro";

const locale = "zh" as const;
---

<BaseLayout locale={locale} pageKey="home">
  <HomeScroll locale={locale} />
</BaseLayout>
