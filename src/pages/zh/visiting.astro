---
/** Instant hop: Astro.redirect() would emit a 2s meta-refresh on static Pages. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/zh/#visiting`;
const canonical = new URL(`${base}/zh/`, Astro.site).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>观展</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
    <style>
      html,
      body {
        margin: 0;
        background: #f7f3ea;
      }
    </style>
  </head>
  <body></body>
</html>
